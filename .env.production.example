# ------------------------------------------------------------------
# Maison Indigo — modèle de .env pour Hostinger Hébergement Premium
# Copier en `.env` sur le serveur, puis `php artisan key:generate`.
# Aucune valeur réelle ne doit être committée.
# ------------------------------------------------------------------

APP_NAME="Maison Indigo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.maisonindigo.ma
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Casablanca
APP_MAINTENANCE_DRIVER=file

# Hostinger sert le site derrière LiteSpeed : on fait confiance au proxy et on force le https.
TRUSTED_PROXIES=*
FORCE_HTTPS=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# Base de données : MySQL/MariaDB créée dans hPanel (Bases de données → MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Pas de Redis sur l'hébergement mutualisé : cache fichier, sessions et file d'attente en base.
# La file est vidée chaque minute par le planificateur (voir routes/console.php).
CACHE_STORE=file
CACHE_PREFIX=mi_
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Filament suit FILESYSTEM_DISK sans cette ligne : les photos partiraient hors du web.
FILAMENT_FILESYSTEM_DISK=public
# Conversions d'images à l'envoi (pas de worker permanent)
QUEUE_CONVERSIONS_BY_DEFAULT=false

# Pas de serveur Node persistant sur l'hébergement mutualisé : rendu côté client.
INERTIA_SSR_ENABLED=false

# Compte administrateur (php artisan db:seed --class=AdminSeeder), puis activer la double authentification dans /admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Coordonnées affichées sur la boutique
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# Coordonnées bancaires pour le paiement par virement
BANK_HOLDER=
BANK_NAME=
BANK_IBAN=

# E-mail transactionnel : SMTP Hostinger (smtp.hostinger.com, port 465, ssl) ou Brevo
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Membres (MailerLite)
MAILERLITE_TOKEN=

# Tracking
META_PIXEL_ID=
META_CAPI_TOKEN=
TIKTOK_PIXEL_ID=
GA4_ID=

# Sauvegardes et médias (S3 compatible, facultatif)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
