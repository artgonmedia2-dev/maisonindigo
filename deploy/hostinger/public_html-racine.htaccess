# ------------------------------------------------------------------
# Repli quand TOUTE l'application a été déposée à la racine de public_html
# (app/, vendor/, public/, .env… directement dedans).
#
# À copier en public_html/.htaccess, après avoir supprimé default.php.
#
# Les règles ne sont pas enveloppées dans <IfModule mod_rewrite.c> : sur
# certaines configurations LiteSpeed le nom du module n'est pas déclaré, le
# bloc est ignoré en silence, et seule la page d'accueil répond.
#
# Rien ne renvoie vers public/$1 : un fichier réel y est servi directement,
# tout le reste part au contrôleur frontal. Ne pas dépendre de public/.htaccess,
# qui n'est pas toujours relu après une réécriture interne.
# ------------------------------------------------------------------

Options -Indexes +FollowSymLinks

DirectoryIndex public/index.php

RewriteEngine On

# Un fichier ou un dossier qui existe réellement dans public/ est servi tel quel
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L]

# Tout le reste : contrôleur frontal de Laravel
RewriteRule ^ public/index.php [L]

# Le reste de l'application n'est pas accessible depuis le web
<FilesMatch "^(\.env|\.env\..*|\.git.*|\.editorconfig|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpstan\.neon|pint\.json|tsconfig\.json|vite\.config\.ts|README\.md|default\.php)$">
    Require all denied
</FilesMatch>
