# ------------------------------------------------------------------
# Maison Indigo — public_html/.htaccess
#
# À utiliser quand TOUTE l'application est à la racine de public_html
# (app/, vendor/, public/, .env… directement dedans).
#
# Trois principes, appris à nos dépens :
#
# 1. Les règles ne sont pas enveloppées dans <IfModule mod_rewrite.c> :
#    certaines configurations LiteSpeed ne déclarent pas le nom du module,
#    le bloc est ignoré en silence et seule la page d'accueil répond.
#
# 2. Rien n'est réécrit vers public/$1 pour une page : public/.htaccess
#    n'est pas relu après une réécriture interne, et la page tombe sur le
#    404 de l'hébergeur. Tout ce qui n'est pas un fichier réel part
#    directement au contrôleur frontal.
#
# 3. Une requête déjà réécrite n'est pas retraitée, sinon la dernière
#    règle boucle sur elle-même et produit une erreur 500.
# ------------------------------------------------------------------

Options -Indexes +FollowSymLinks

DirectoryIndex public/index.php

RewriteEngine On

# 3. Une réécriture interne a déjà eu lieu : on ne retouche à rien
RewriteCond %{ENV:REDIRECT_STATUS} ^.+$
RewriteRule ^ - [L]

# La racine du site : directement le contrôleur frontal, sans passer par
# l'index de dossier, que LiteSpeed refuse après une réécriture interne.
RewriteRule ^$ public/index.php [L]

# Les médias : servis directement depuis storage/app/public, sans dépendre du
# lien symbolique public/storage, que le serveur web ne traverse pas toujours.
RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$1 -f
RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

# 2. Un fichier ou un dossier qui existe vraiment dans public/ est servi tel quel
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L]

# Tout le reste : contrôleur frontal de Laravel
RewriteRule ^ public/index.php [L]

# Le reste de l'application n'est pas accessible depuis le web
<FilesMatch "^(\.env|\.env\..*|\.git.*|\.editorconfig|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpstan\.neon|pint\.json|tsconfig\.json|vite\.config\.ts|README\.md|default\.php)$">
    Require all denied
</FilesMatch>

# Les médias servis depuis storage/ ne passent pas par public/.htaccess :
# sans ces types, LiteSpeed renvoie les AVIF et WebP en text/plain.
# Sans <IfModule> : LiteSpeed ignore ces blocs en silence.
AddType image/avif .avif
AddType image/webp .webp
AddType image/jpeg .jpg .jpeg
AddType image/png .png
