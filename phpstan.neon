includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database/factories
        - database/seeders
    checkModelProperties: true
    # Lit le tableau retourné par casts() plutôt que son type PHPDoc
    parseModelCastsMethod: true
    treatPhpDocTypesAsCertain: false
